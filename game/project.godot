; ABOUTME: Godot 4.7 project file for Apocalypse Barista, a top-down 2D Android game.
; ABOUTME: Compatibility renderer, typed GDScript, GdUnit4 for automated tests.

config_version=5

[application]

config/name="Apocalypse Barista"
run/main_scene="res://scenes/main/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
throw_coffee={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventMouseButton,"button_index":1)]
}
drink_coffee={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
serve_coffee={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
dodge={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
use_tool={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
plant_coffee={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":80)]
}
cycle_tool={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
fire_weapon={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":84)]
}
cycle_weapon={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":88)]
}
refill_coffee={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
stop_grind={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":69), Object(InputEventMouseButton,"button_index":1)]
}
hold_pressure={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventMouseButton,"button_index":1)]
}
lift_pot={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":69), Object(InputEventMouseButton,"button_index":1)]
}
call_van={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
start_brew={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":66)]
}
toggle_dex={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
